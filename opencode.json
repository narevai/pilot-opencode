{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "flightsim-pilot": {
      "type": "remote",
      "url": "{env:IRL_GYM_MCP_URL}",
      "enabled": true
    }
  },
  "permission": {
    "doom_loop": "allow",
    "external_directory": {
      "/etc/*": "allow"
    }
  },
  "provider": {
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      }
    }
  }
}
